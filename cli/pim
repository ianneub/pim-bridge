        c("update_contact", contact=a.contact, name=a.name, first=a.first, last=a.last, company=a.org,
          title=a.title, nickname=a.nickname, note=a.note, birthday=a.birthday, add_phones=a.phone or None,
          add_emails=a.email or None, add_addresses=a.address or None, add_urls=a.url or None,
          remove_phones=a.remove_phone or None, remove_emails=a.remove_email or None,
          remove_addresses=a.remove_address or None, remove_urls=a.remove_url or None)
    elif a.cmd == "delete":
        c("delete_contact", contact=a.contact)
    elif a.cmd == "tool":
        run_tool("contacts", a)


# --- gmail -------------------------------------------------------------------

def mail_line(m):
    unread = color("1", "●") if m.get("unread") else " "
    date = (m.get("date") or "")[:16].replace("T", " ")
    sender = m.get("from", "")
    if "<" in sender and not sender.startswith("<"):
        sender = sender.split("<")[0].strip().strip('"')
    return (f"{unread} {color('36', m['id'])} {color('33', date)} {sender[:28]:<28} {m.get('subject') or '(no subject)'}"
            + ("\n" + " " * 20 + color("2", m["snippet"][:100]) if m.get("snippet") else ""))


def show_message(m, html):
    for key in ("from", "to", "cc", "bcc", "reply_to", "subject", "date"):
        if m.get(key):
            print(color("2", f"{key.replace('_', '-').title() + ':':<10}") + f" {m[key]}")
    for a in m.get("attachments", []):
        print(color("2", "Attached:  ") + f"{a['filename'] or '(inline)'} ({a['mime_type']}, {a['size']} bytes)")
    print()
    print(m.get("html") if html and m.get("html") else m.get("text", ""))


def gmail_main(argv):
    if not argv:
        argv = ["inbox"]
    p = argparse.ArgumentParser(prog="gmail", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("inbox")
    sub.add_parser("accounts")
    si = sub.add_parser("sign-in")
    si.add_argument("email")
    si.add_argument("name", nargs="?")
    so = sub.add_parser("sign-out")
    so.add_argument("account")
    so.add_argument("--remove", action="store_true")
    for name in ("search", "drafts"):
        q = sub.add_parser(name)
        q.add_argument("account")
        q.add_argument("query", nargs="*")
        q.add_argument("-n", type=int, default=25)
    for name, ident in (("read", "id"), ("thread", "thread_id"), ("draft", "draft_id")):
        q = sub.add_parser(name)
        q.add_argument("account")
        q.add_argument(ident)
        q.add_argument("--html", action="store_true")
    new = sub.add_parser("new")
    new.add_argument("account")
    new.add_argument("--reply-to")
    ed = sub.add_parser("edit")
    ed.add_argument("account")
    ed.add_argument("draft_id")
    for q in (new, ed):
        q.add_argument("--to", action="append")
        q.add_argument("--cc", action="append")
        q.add_argument("--bcc", action="append")
        q.add_argument("-s", "--subject")
        body = q.add_mutually_exclusive_group()
        body.add_argument("--html", metavar="FILE")
        body.add_argument("--text")
    for name in ("trash", "untrash"):
        q = sub.add_parser(name)
        q.add_argument("account")
        q.add_argument("ids", nargs="+")
    lg = sub.add_parser("log")
    lg.add_argument("account", nargs="?")
    lg.add_argument("-d", "--days", type=int, default=30)
    tool_parser(sub)
    a = p.parse_args(argv)

    g = lambda tool, **kw: json.loads(call("gmail", tool, **kw))
    if a.cmd == "inbox":
        accounts = [x for x in g("accounts")["accounts"] if x["status"] == "signed_in"]
        if not accounts:
            die("no Gmail account is signed in; gmail sign-in EMAIL NAME")
        for x in accounts:
            found = g("search", account=x["email"], query="is:unread in:inbox", max=50)["messages"]
            print(color("1", f"{x['name']} · {x['email']}") + color("2", f"  {len(found)} unread"))
            for m in found:
                print("  " + mail_line(m).replace("\n", "\n  "))
    elif a.cmd == "accounts":
        reply = g("accounts")
        if reply.get("problem"):
            print(color("31", reply["problem"]))
        for x in reply["accounts"]:
            print(f"{x['name']:<12} {x['email']:<28} {x['status']}" + (color("2", "  " + x["problem"]) if x.get("problem") else ""))
    elif a.cmd == "sign-in":
        r = g("sign_in", email=a.email, name=a.name)
        print(f"Finish signing in {r['email']} in the browser. If no window opened:\n{r['url']}")
    elif a.cmd == "sign-out":
        r = g("sign_out", account=a.account, remove=a.remove or None)
        print(f"signed out {r['signed_out']}" + (" and removed it" if r["removed"] else ""))
    elif a.cmd == "search":
        r = g("search", account=a.account, query=" ".join(a.query), max=a.n)
        print("\n".join(mail_line(m) for m in r["messages"]) or color("2", "nothing"))
    elif a.cmd == "drafts":
        r = g("list_drafts", account=a.account, query=" ".join(a.query) or None, max=a.n)
        for d in r["drafts"]:
            print(f"{color('36', d['draft_id'])} {color('33', (d.get('date') or '')[:16].replace('T', ' '))} "
                  f"{(d.get('to') or '(no recipients)')[:30]:<30} {d.get('subject') or '(no subject)'}")
    elif a.cmd == "read":
        show_message(g("read_message", account=a.account, id=a.id, html=a.html or None), a.html)
    elif a.cmd == "thread":
        for i, m in enumerate(g("read_thread", account=a.account, thread_id=a.thread_id, html=a.html or None)["messages"]):
            if i:
                print(color("2", "\n" + "─" * 60 + "\n"))
            show_message(m, a.html)
    elif a.cmd == "draft":
        d = g("get_draft", account=a.account, draft_id=a.draft_id)
        show_message(d, a.html)
    elif a.cmd in ("new", "edit"):
        html = None
        if a.html:
            html = sys.stdin.read() if a.html == "-" else open(a.html).read()
        fields = dict(account=a.account, to=a.to, cc=a.cc, bcc=a.bcc, subject=a.subject, html=html, text=a.text)
        if a.cmd == "new":
            d = g("create_draft", reply_to_message_id=a.reply_to, **fields)
        else:
            d = g("update_draft", draft_id=a.draft_id, **fields)
        print(f"draft {d['draft_id']}: {d.get('subject') or '(no subject)'} → {d.get('to') or '(no recipients)'}\n{d['url']}")
    elif a.cmd in ("trash", "untrash"):
        if a.cmd == "trash":
            print(color("2", "Confirm with Touch ID on the Mac..."), file=sys.stderr)
        r = json.loads(call("gmail", a.cmd, timeout=150, account=a.account, ids=a.ids))
        for m in r[a.cmd + "ed"]:
            print(f"{a.cmd}ed {color('36', m['id'])} {m['from'][:30]} · {m['subject']}")
        for f in r["failed"]:
            print(color("31", f"failed {f['id']}: {f['error']}"), file=sys.stderr)
    elif a.cmd == "log":
        for e in g("trash_log", account=a.account, days=a.days)["entries"]:
            print(f"{color('33', e['time'][:16].replace('T', ' '))}Z {e['action']:<8} {e['account']:<22} "
                  f"{color('2', e['caller']):<8} {e['from'][:28]:<28} {e['subject']}")
    elif a.cmd == "tool":
        print(call("gmail", a.name, timeout=150, **json.loads(a.json)))


